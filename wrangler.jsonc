{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fiend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "browser": { "binding": "BROWSER" },
  "dev": { "host": "localhost:8787" },
  "routes": [
    { "pattern": "anoma.ly/labs/fiend", "zone_name": "anoma.ly" },
    { "pattern": "anoma.ly/labs/fiend/*", "zone_name": "anoma.ly" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "SCENES", "class_name": "SceneRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SceneRoom"] }],
  "observability": { "enabled": true }
}
